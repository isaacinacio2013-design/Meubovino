                            </div>
                            <div>
                                <h4 class="font-bold text-gray-900 text-sm">${loc}</h4>
                                <p class="text-xs text-gray-500">${count} ${count === 1 ? 'animal' : 'animais'}</p>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-right text-xs text-gray-400"></i>
                    </div>
                `;
            }).join('');
        }

        // --- INICIALIZAÇÃO DA APLICAÇÃO ---
        window.onload = function() {
            updateDashboard();
            renderRecent();
            renderRebanho();
            renderAlertas();
            renderAreas();
        };
